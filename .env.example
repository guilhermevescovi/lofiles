# ========================================
# lofiles-dashboard Environment Variables
# ========================================

# ---- GitHub OAuth App Configuration ----
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL should be: http://your-domain:3001/auth/callback
# (For local dev: http://localhost:3001/auth/callback)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ---- Session Configuration ----
# Generate a secure random string for session encryption
# Example: openssl rand -hex 32
SESSION_SECRET=generate_a_random_secret_here_min_32_chars

# ---- Backend Configuration ----
# Port for the Express backend server (default: 3001)
PORT=3001

# Frontend URL for CORS and OAuth redirects
# For production self-hosted: https://yourdomain.com
# For local development: http://localhost:3000 (if running frontend separately)
# For Docker/production (single server): http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ---- Frontend Configuration (Build-time) ----
# Backend URL for API calls (only needed during frontend build)
# For production: leave empty or set to same domain
# For local development with separate frontend/backend servers:
REACT_APP_BACKEND_URL=http://localhost:3001

# ---- Docker Compose ----
# Custom port mapping (optional, defaults to 3001)
# APP_PORT=3001

# ---- Environment ----
NODE_ENV=production
